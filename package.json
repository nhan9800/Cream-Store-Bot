{
  "name": "cenar-store-bot",
  "version": "1.10.4",
  "description": "Bot ho tro ban hang Discord.js cho Cenar Store voi PayOS, ticket phan loai, dashboard, blacklist, role tu dong va backup/export.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "check:syntax": "node scripts/check-syntax.js",
    "check:imports": "node scripts/check-imports.js",
    "check:commands": "node scripts/check-commands.js",
    "check:env": "node scripts/check-env.js",
    "test:unit": "node --test tests/**/*.test.js",
    "test:integration": "node --test tests/**/*.integration.js",
    "test:migrations": "echo \"Migration tests will be added\"",
    "test:ci": "npm run test:unit",
    "backup": "node scripts/backup.js",
    "verify:backup": "node scripts/verify-backup.js",
    "confirm:webhook": "node scripts/confirm-payos-webhook.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "better-sqlite3": "^12.9.0",
    "discord.js": "14.25.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4"
  }
}
