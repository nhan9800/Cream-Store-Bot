{
  "name": "cenar-store-bot",
  "version": "1.11.0",
  "description": "Multi-store Discord commerce bot for Cenar Store and Cenar Global with secure payments, support, automation and recovery.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:vibehost": "bash scripts/vibehost-supervisor.sh",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "smoke": "node scripts/smoke-test.js",
    "check:env": "node scripts/check-env.js",
    "confirm:webhook": "node scripts/confirm-payos-webhook.js",
    "publish:birthday-sale": "node scripts/publish-birthday-sale.js",
    "publish:ai-creative-pricing": "node scripts/publish-ai-creative-pricing-update.js",
    "publish:youtube-family-policy": "node scripts/publish-youtube-family-policy-update.js",
    "publish:youtube-stability-transition": "node scripts/publish-youtube-stability-transition.js",
    "publish:national-day-sale": "node scripts/publish-national-day-sale.js",
    "publish:mid-autumn-sale": "node scripts/publish-mid-autumn-sale.js",
    "publish:daily-color-sale": "node scripts/publish-daily-color-sale.js",
    "publish:weekly-sale-20261009": "node scripts/publish-weekly-sale-20261009.js",
    "publish:pubg-drama-sale": "node scripts/publish-pubg-drama-sale.js",
    "publish:profile-effect-giveaway": "node scripts/publish-profile-effect-giveaway.js",
    "publish:custom-services": "node scripts/publish-custom-services-launch.js",
    "publish:transcript-archive-launch": "node scripts/publish-transcript-archive-launch.js",
    "publish:youtube-join-fam-guide": "node scripts/publish-youtube-join-fam-guide.js",
    "publish:nitro-gmail-phone-guide": "node scripts/publish-nitro-gmail-phone-guide.js",
    "publish:gemini-pricing-update": "node scripts/publish-gemini-pricing-update.js",
    "clear:promotions": "node scripts/clear-promotion-channel.js",
    "sync:promotion-emojis": "node scripts/sync-promotion-emojis.js",
    "publish:boost-level3-sale": "node scripts/publish-server-boost-level3-sale.js",
    "publish:partner-national-day": "node scripts/publish-partner-national-day-update.js",
    "audit:emojis": "node scripts/audit-guild-emojis.js",
    "audit:emojis:apply": "node scripts/audit-guild-emojis.js --apply",
    "normalize:emojis": "node scripts/normalize-guild-emoji-names.js",
    "normalize:emojis:apply": "node scripts/normalize-guild-emoji-names.js --apply",
    "sync:emojis": "node scripts/sync-curated-emojis.js",
    "setup:admin-orders": "node scripts/setup-store1-order-center.js",
    "publish:verify": "node scripts/publish-verification-panel.js",
    "backup": "node scripts/backup-production.js",
    "verify:backup": "node scripts/verify-backup.js",
    "test": "vitest run --maxWorkers=1 --fileParallelism=false",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const entry=require.resolve('@discord-player/extractor');for(const file of [entry,path.join(path.dirname(entry),'index.mjs')]){const source=fs.readFileSync(file,'utf8');const patched=source.replaceAll('fileType.fromFile(','fileType.fileTypeFromFile(');if(patched===source&&!source.includes('fileType.fileTypeFromFile('))throw new Error('Extractor compatibility target missing');if(patched!==source)fs.writeFileSync(file,patched)}\"",
    "check:deps": "node scripts/check-dependency-security.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@google/genai": "1.52.0",
    "@snazzah/davey": "0.1.12",
    "@tesseract.js-data/eng": "1.0.0",
    "better-sqlite3": "12.11.1",
    "discord-player": "^7.2.0",
    "discord-player-youtubedlp": "1.2.2",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "ffmpeg-static": "^5.3.0",
    "mediaplex": "1.0.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@google/genai": true,
    "better-sqlite3": true,
    "esbuild": true,
    "ffmpeg-static": true,
    "protobufjs": true,
    "ytdlp-nodejs": false
  },
  "overrides": {
    "file-type": "21.3.4",
    "qs": "6.16.0",
    "esbuild": "0.28.1"
  }
}
