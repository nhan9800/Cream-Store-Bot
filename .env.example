# ==========================================
# Cenar Store Bot - Environment Configuration
# ==========================================

# 1. Database
DATABASE_PATH=data/store1.sqlite

# 2. Discord Configuration
CLIENT_ID=
GUILD_ID=
BOT_TOKEN=
COMMAND_PREFIX=!

# 3. Web & Proxy Configuration
HTTP_PORT=2753
PUBLIC_BASE_URL=https://cenarstore.xyz
WEBSITE_URL=https://cenarstore.xyz
DEBUG_ENDPOINTS_ENABLED=false

# 4. Security & Secrets (Must NOT be shared)
BOT_API_KEY=
DEPLOY_SECRET=
DASHBOARD_SESSION_SECRET=
ENCRYPTION_KEY=
DASHBOARD_TOKEN=

# 5. Features
DASHBOARD_ENABLED=true
PAYOS_WEBHOOK_PATH=/webhooks/payos
SEPAY_WEBHOOK_PATH=/webhooks/sepay
PAYOS_RETURN_PATH=/payments/payos/return
PAYOS_CANCEL_PATH=/payments/payos/cancel
