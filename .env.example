# ==============================================================================
# Cenar Store Bot - Mẫu biến môi trường
# ------------------------------------------------------------------------------
# Copy file này thành .env (Store 1) hoặc .env.store2 (Store 2) rồi điền giá trị.
# TUYỆT ĐỐI KHÔNG commit .env / .env.store2 chứa giá trị thật lên git.
# Các biến đánh dấu [BẮT BUỘC] phải có, còn lại có giá trị mặc định trong code.
# ==============================================================================

# ── Discord Bot [BẮT BUỘC] ────────────────────────────────────────────────────
# BOT_TOKEN: token bot Discord (Developer Portal > Bot > Reset Token)
BOT_TOKEN=YOUR_BOT_TOKEN
# CLIENT_ID: Application ID (Developer Portal > General Information)
CLIENT_ID=YOUR_CLIENT_ID
# GUILD_ID: ID server Discord để đăng ký slash command
GUILD_ID=YOUR_GUILD_ID
OWNER_ROLE_IDS=1282638119497109524
PROTECTED_OWNER_ID=1138315103821889566
DISCORD_NITRO_ROLE_IDS=
DISCORD_NITRO_USER_IDS=1138315103821889566
# STORE_NAME: tên hiển thị của shop
STORE_NAME=Cenar Store

# ViOTP - token API dùng cho tính năng thuê số nhận OTP (tuỳ chọn)
# Lấy tại tài khoản ViOTP, không commit token thật lên Git.
VIOTP_TOKEN=

# Card2K / CardSwap - ưu tiên secret trong env thay vì lưu trực tiếp vào database.
# Một callback có thể phục vụ cả hai Store; launcher sẽ định tuyến theo request_id.
CARDSWAP_PARTNER_ID=
CARDSWAP_PARTNER_KEY=
CARDSWAP_DOMAIN=card2k.net
CARDSWAP_CHARGING_FEE_ADD=3

# ── HTTP / API nội bộ ─────────────────────────────────────────────────────────
# SERVER_PORT: cổng public của launcher/reverse proxy.
# STORE1_HTTP_PORT và STORE2_HTTP_PORT: cổng loopback nội bộ; cả ba cổng phải khác nhau.
# Hosting tự cấp PORT có thể bỏ SERVER_PORT, nhưng PORT vẫn phải khác hai cổng nội bộ.
# VibeHost public allocation. If the panel injects PORT, keep it equal to this value.
SERVER_PORT=20022
STORE1_HTTP_PORT=5000
STORE2_HTTP_PORT=8080
# BOT_API_KEY: khóa chung giữa website Next.js và bot API (server-to-server).
#   Website phải gửi header x-bot-api-key khớp giá trị này. Sinh chuỗi ngẫu nhiên
#   đủ dài, ví dụ: cnr_<hex 48 ký tự>. KHÔNG dùng lại khóa đã lộ.
BOT_API_KEY=YOUR_BOT_API_KEY
# DASHBOARD_ENABLED / DASHBOARD_TOKEN: dashboard mini nội bộ
DASHBOARD_ENABLED=true
DASHBOARD_TOKEN=YOUR_DASHBOARD_TOKEN

# ── Mã hóa dữ liệu nhạy cảm [BẮT BUỘC] ────────────────────────────────────────
# ENCRYPTION_KEY: 64 ký tự hex (32 byte). Cả 2 store PHẢI dùng CHUNG một khóa vì
#   dùng chung DB. Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   LƯU Ý: đổi khóa này sẽ làm KHÔNG giải mã được credential đã lưu trước đó.
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_KEY

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_PATH: đường dẫn file SQLite. Store 1 để mặc định, Store 2 dùng file riêng.
DATABASE_PATH=./data/shopbot.sqlite

# Store 2 international profile (.env.store2)
# Dedicated global variables prevent Store 1 values inherited by the launcher
# from leaking into the Store 2 brand.
GLOBAL_STORE_NAME=Cenar Global
GLOBAL_STORE_LOCALE=en-US
GLOBAL_STORE_CURRENCY=USD
GLOBAL_STORE_FOOTER=Cenar Global - International Digital Services
GLOBAL_SHIPPER_NAME=Cenar Global Delivery
GLOBAL_SHIPPER_FOOTER=Cenar Global
GLOBAL_AI_SYSTEM_PROMPT=You are the Cenar Global customer assistant. Reply clearly, professionally and concisely in English.
# Existing catalog values are VND; this configured rate is used only for the
# international display and Binance Pay conversion. Review it periodically.
STORE_PRICE_SOURCE_CURRENCY=VND
STORE_VND_PER_USD=26000

# ── PayOS - Thanh toán [BẮT BUỘC nếu PAYMENT_PROVIDER=PAYOS] ──────────────────
PAYMENT_PROVIDER=PAYOS
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY
# PUBLIC_BASE_URL [BẮT BUỘC]: domain công khai để PayOS gọi webhook/return/cancel.
PUBLIC_BASE_URL=https://your-domain.example
# Website công khai hiển thị trong panel Discord (không dùng URL hosting nội bộ).
STORE_WEBSITE_URL=https://cenarstore.xyz
# Đường dẫn webhook/return/cancel (có mặc định, thường không cần đổi).
PAYOS_WEBHOOK_PATH=/webhooks/payos
PAYOS_RETURN_PATH=/payments/payos/return
PAYOS_CANCEL_PATH=/payments/payos/cancel

# ── Binance Pay Merchant (Store 2; disabled until Merchant credentials exist) ──
# Create the API identity/secret in Binance Merchant Admin. Never use a normal
# exchange API key and never commit either credential to Git.
BINANCE_PAY_ENABLED=false
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_API_BASE=https://bpay.binanceapi.com
BINANCE_PAY_CURRENCY=USDT
BINANCE_PAY_CURRENCIES=USDT,USDC
# Use these dedicated Store 2 paths so the public launcher cannot route crypto
# callbacks into Store 1. The code applies these defaults automatically for
# guild 1070676180103086132 when the variables are omitted.
BINANCE_PAY_WEBHOOK_PATH=/webhooks/binance-pay-store2
BINANCE_PAY_RETURN_PATH=/payments/binance-pay-store2/return
BINANCE_PAY_CANCEL_PATH=/payments/binance-pay-store2/cancel
BINANCE_PAY_EXPIRE_MINUTES=60
# TRANSCRIPT_BASE_URL: domain dùng để khách xem transcript trên web (bot không gửi file đính kèm).
# TRANSCRIPT_BASE_URL=https://api.your-domain.example
TRANSCRIPT_RETENTION_DAYS=30
SUBSCRIPTION_ADMIN_REMINDER_DAYS=7
SUBSCRIPTION_ADMIN_SNOOZE_HOURS=24

# ── VietQR fallback (dùng khi guild chưa /setup-bank) ─────────────────────────
VIETQR_BANK_BIN=970418
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=CENAR STORE

# ── AI trợ lý (tùy chọn) ──────────────────────────────────────────────────────
# GROQ_API_KEY hoặc OPENROUTER_API_KEY: để trống nếu không dùng tính năng AI.
GROQ_API_KEY=
# GEMINI_API_KEYS: danh sách key ngăn cách dấu phẩy (nếu dùng Gemini).
GEMINI_API_KEYS=
# Quét ảnh lừa đảo ở kênh công khai. Store 1 mặc định bật, Store 2 mặc định tắt.
ANTI_SCAM_ENABLED=true
ANTI_SCAM_VISION_MODEL=gemini-2.5-flash
ANTI_SCAM_CONFIDENCE_THRESHOLD=0.90
ANTI_SCAM_QUARANTINE_MINUTES=30
ANTI_SCAM_MAX_IMAGE_MB=8
ANTI_SCAM_DOWNLOAD_TIMEOUT_MS=8000
ANTI_SCAM_OCR_TIMEOUT_MS=30000
ANTI_SCAM_VISION_TIMEOUT_MS=20000

# ── Backup Telegram (tùy chọn nhưng nên có) ───────────────────────────────────
# Tạo bot mới qua @BotFather, lấy token; lấy chat_id nơi nhận file backup.
# Nếu để trống, chức năng gửi backup qua Telegram sẽ bị bỏ qua.
TELEGRAM_BACKUP_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
# Số bản backup cục bộ giữ lại. Tối thiểu 3 để tránh một file lỗi ghi đè điểm phục hồi gần nhất.
BACKUP_RETENTION=3

# ── Backup Google Drive (tùy chọn) ────────────────────────────────────────────
# Service account của Google Cloud (dùng cho backup lên Drive).
GD_CLIENT_EMAIL=
# GD_PRIVATE_KEY: dùng \n cho ký tự xuống dòng, bọc trong dấu nháy kép.
GD_PRIVATE_KEY=
GD_FOLDER_ID=

# ── Cenar Hub / liên kết chuyển server (tùy chọn) ─────────────────────────────
# CENAR_HUB_URL / CENAR_HUB_TOKEN: dùng cho lệnh /chuyen-server giữa các store.
CENAR_HUB_URL=
CENAR_HUB_TOKEN=
# CENAR_HUB_SILENT: đặt true để tắt log Hub.
CENAR_HUB_SILENT=false

# ── Website / OAuth / CORS (tùy chọn) ─────────────────────────────────────────
# WEBSITE_URL: URL website chính (dùng trong một số link).
WEBSITE_URL=
WEB_CHECKOUT_ENABLED=false
# CLIENT_SECRET: Discord OAuth secret (nếu dùng đăng nhập web qua Discord).
CLIENT_SECRET=
# OAUTH_STATE_SECRET: khóa HMAC riêng bảo vệ phiên xác minh chống CSRF/replay chéo trình duyệt.
# Có thể để trống để dùng ENCRYPTION_KEY, nhưng production nên dùng chuỗi ngẫu nhiên riêng >= 32 byte.
OAUTH_STATE_SECRET=
# CORS_ALLOWED_ORIGINS: danh sách origin được phép, ngăn cách dấu phẩy.
CORS_ALLOWED_ORIGINS=
# GITHUB_REPO_URL: dùng cho luồng tự cập nhật/backup (nếu có).
GITHUB_REPO_URL=

# ── Cờ nội bộ tiến trình con (KHÔNG chỉnh tay) ────────────────────────────────
# IS_CHILD_BOT / ENV_FILE do launcher tự set khi chạy đa store.
